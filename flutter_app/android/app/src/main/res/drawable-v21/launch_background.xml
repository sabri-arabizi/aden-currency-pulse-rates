<?xml version="1.0" encoding="utf-8"?>
<!--
  شاشة البداية الأصلية للنسخة v21+ (تظهر قبل تحمّل Flutter):
  نسخة مطابقة للافتراضية بخلفية متدرّجة بنية/ذهبية + شعار التطبيق.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- الخلفية المتدرّجة المطابقة لألوان التطبيق (AppColors.backgroundGradient). -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="315"
                android:startColor="#78350F"
                android:centerColor="#713F12"
                android:endColor="#92400E" />
        </shape>
    </item>

    <!-- صورة شاشة البداية المصممة (تملأ الشاشة). -->
    <item>
        <bitmap
            android:gravity="fill"
            android:src="@drawable/splash" />
    </item>
</layer-list>
